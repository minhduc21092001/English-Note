{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "english-blog",
  "main": "src/worker/index.ts",
  // Builds the admin editor into ./dist before every deploy, so no separate "Build command" is needed.
  "build": { "command": "npm run build:admin" },
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // No IDs on purpose: Wrangler creates the D1 database and R2 bucket on first deploy.
  "d1_databases": [{ "binding": "DB" }],
  "r2_buckets": [{ "binding": "MEDIA" }]
}
